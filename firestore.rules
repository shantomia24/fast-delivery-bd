rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      // role যেন সাধারণ ব্যবহারকারী নিজে admin করতে না পারে।
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'customer';
      allow update: if signedIn() && (request.auth.uid == userId || isAdmin())
        && (isAdmin() || request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /riders/{riderId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == riderId);
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid;
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (signedIn() && resource.data.riderId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn() && resource.data.riderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['orderStatus', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /delivery_rates/{rateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /delivery_tracking/{trackingId} {
      allow read: if isAdmin()
        || (signedIn() &&
          (resource.data.customerId == request.auth.uid
          || resource.data.riderId == request.auth.uid));
      allow create, update: if isAdmin()
        || (signedIn() && request.resource.data.riderId == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
